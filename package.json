{
  "name": "lingling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "python -m uvicorn server.main:app --host 127.0.0.1 --port 3001 --reload",
    "dev:web": "npm run dev --workspace web",
    "build": "python -m compileall server && npm run build --workspace web",
    "typecheck": "python -m compileall server && npm run typecheck --workspace web",
    "seed": "python -m server.scripts.seed",
    "verify": "python -m server.scripts.verify",
    "verify:dao": "python -m server.scripts.verify",
    "verify:seed": "python -m server.scripts.verify",
    "verify:llm": "python -m server.scripts.verify",
    "verify:llm:http": "python -m server.scripts.verify"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
